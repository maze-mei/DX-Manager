      <CompanionApkSource>$(CompanionSharedRoot)\release\DX-Companion.apk</CompanionApkSource>
      <CompanionApkTarget>$(TargetDir)tools\companion\DX-Companion.apk</CompanionApkTarget>
    </PropertyGroup>
    <MakeDir
      Directories="$(TargetDir)tools\companion"
      Condition="Exists('$(CompanionApkSource)')" />
    <Copy
      SourceFiles="$(CompanionApkSource)"
      DestinationFiles="$(CompanionApkTarget)"
      SkipUnchangedFiles="true"
      Condition="Exists('$(CompanionApkSource)')" />
    <Delete
      Files="$(CompanionApkTarget)"
      Condition="!Exists('$(CompanionApkSource)') And Exists('$(CompanionApkTarget)')" />
  </Target>
