    <Compile Include="../DexManager/Models/LastSuccessSettings.cs" Link="Windows/LastSuccessSettings.cs" />
    <Compile Include="../DexManager/Services/SettingsService.cs" Link="Windows/SettingsService.cs" />
    <Compile Include="../DexManager/Services/LogService.cs" Link="Windows/LogService.cs" />
    <Compile Include="../DexManager/Services/LocalizationService.cs" Link="Windows/LocalizationService.cs" />
    <Compile Include="../DexManager/Services/LoopbackDexProtocol.cs" Link="Windows/LoopbackDexProtocol.cs" />
    <Compile Include="../DexManager/Services/LoopbackDexService.cs" Link="Windows/LoopbackDexService.cs" />
    <Compile Include="../DexManager/Services/VirtualDisplayService.cs" Link="Windows/VirtualDisplayService.cs" />
    <Compile Include="../DexManager/Services/AdbService.cs" Link="Windows/AdbService.cs" />
    <Compile Include="../DexManager/Services/AdbCommandBuilder.cs" Link="Windows/AdbCommandBuilder.cs" />
    <Compile Include="../DexManager/Utils/ProcessRunner.cs" Link="Windows/ProcessRunner.cs" />
