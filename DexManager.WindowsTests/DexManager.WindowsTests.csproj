    <Compile Include="../DexManager/Models/FrameRateRules.cs" Link="Windows/FrameRateRules.cs" />
    <Compile Include="../DexManager/Models/DisplayInfo.cs" Link="Windows/DisplayInfo.cs" />
    <Compile Include="../DexManager/Models/VirtualDisplayLease.cs" Link="Windows/VirtualDisplayLease.cs" />
    <EmbeddedResource Include="../DexManager/Resources/Strings.resx" Link="Resources/Strings.resx" />
    <EmbeddedResource Include="../DexManager/Resources/Strings.ko.resx" Link="Resources/Strings.ko.resx" />
    <Content Include="../tools/loopback/dxm-loopback.jar" Link="tools/loopback/dxm-loopback.jar" CopyToOutputDirectory="PreserveNewest" />
